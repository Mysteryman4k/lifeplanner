<?xml version="1.0" encoding="utf-8"?>
<!-- The window (pywebview) runs on .NET through pythonnet. Files unzipped from a downloaded zip carry Windows'
     "from the internet" mark, and .NET Framework won't load a marked DLL unless the app allows it. desktop.py loads
     .NET with this file, so the portable version starts. Only EasyUniTrack's own bundled DLLs are loaded this way. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
