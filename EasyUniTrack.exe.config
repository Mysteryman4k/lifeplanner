<?xml version="1.0" encoding="utf-8"?>
<!-- Copied next to EasyUniTrack.exe by EasyUniTrack.spec: .NET Framework reads <exe name>.config when it starts.
     The window (pywebview) runs on .NET through pythonnet. Files unzipped from a downloaded zip carry Windows'
     "from the internet" mark, and .NET Framework won't load a marked DLL (pythonnet's Python.Runtime.dll) unless
     the app allows it, which made the portable 4.0.0-beta.1 crash at start. It only loads EasyUniTrack's own
     bundled DLLs. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
