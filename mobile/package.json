{
  "name": "easyunitrack-mobile",
  "private": true,
  "description": "EasyUniTrack for Android and iPhone: the desktop app's screens with its server rebuilt to run on the phone",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs",
    "sync": "node scripts/build.mjs && cap sync",
    "android": "node scripts/build.mjs && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
